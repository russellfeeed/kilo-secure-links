{
  "name": "@securelinks/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:package",
    "copy:package": "node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/client-cloudwatch": "^3.600.0"
  },
  "devDependencies": {
    "typescript": "~5.4.0",
    "@types/aws-lambda": "^8.10.14",
    "@types/node": "^20.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
